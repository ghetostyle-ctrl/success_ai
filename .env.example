# ── Success AI 환경설정 ─────────────────────────────────────────
# 이 파일을 .env 와 .env.local 두 개로 복사하세요 (내용은 같아도 됩니다).
#   앱(Next.js)은 .env.local 을, Prisma CLI 는 .env 만 읽습니다.
# install.ps1 을 쓰면 자동으로 두 파일이 만들어집니다.

# SQLite 경로 (기본값 그대로 두면 프로젝트 루트의 dev.db 사용)
DATABASE_URL="file:./dev.db"

# YouTube Data API v3 키 (권장). 없으면 조회수·성과 배지가 전부 비어 있습니다.
# 발급: Google Cloud Console → API 및 서비스 → 라이브러리 → YouTube Data API v3 사용
#       → 사용자 인증 정보 → API 키 만들기 → "API 제한사항"에서 YouTube Data API v3 만 허용
YOUTUBE_API_KEY=

# ── 선택 ────────────────────────────────────────────────────────
# 주거용 프록시 (구글 투명성 센터 봇 차단이 잦을 때). 형식: http://USER:PASS@HOST:PORT
# PROXY_URL=

# 메타 광고 라이브러리 수집 모드: web(기본, 로그인 불필요) | graph(META_ACCESS_TOKEN 필요, 메타 신원인증 선행)
# META_MODE=web
# META_ACCESS_TOKEN=

# 수집 성공/실패 슬랙 알림
# SLACK_WEBHOOK_URL=

# yt-dlp 실행파일 경로 (PATH 에 없을 때만)
# YT_DLP_PATH=
